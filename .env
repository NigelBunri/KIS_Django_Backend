# ==========================================
# Django Basic Config
# ==========================================

# Environment mode
DJANGO_ENV=production

# Django secret key (testing value)
SECRET_KEY=django-prod-kis-2026-super-long-secret-key-change-later-9f7a2c1b8e4d6a0f3c9b5x
JWT_SECRET=jwt-prod-kis-2026-super-long-secret-key-change-later-8e6b4a2c9f1d7x

# Production debug setting
