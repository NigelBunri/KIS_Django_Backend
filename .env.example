# ==========================================
# KIS DJANGO LIVE ENVIRONMENT EXAMPLE
# ==========================================
# Use this as the Render Django service environment checklist.
# Never commit real secrets, passwords, private keys, provider tokens, service-account JSON, or webhook secrets.
# Put real values in Render Environment Variables / secret manager only.

# ==========================================
# 01. Core Django / Render
# ==========================================

DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
TIME_ZONE=UTC

# Generate unique high-entropy values per environment.
SECRET_KEY=replace-with-a-strong-random-django-secret-at-least-50-chars
JWT_SECRET=replace-with-a-different-strong-random-jwt-secret-at-least-50-chars
DJANGO_INTERNAL_TOKEN=replace-with-a-strong-random-internal-service-token-shared-with-nest
INTERNAL_SIGNATURE_REQUIRED=True
INTERNAL_SIGNATURE_MAX_SKEW_SECONDS=300

# Public Django API deployment URLs/hosts.
# Example Render host: kis-django-live.onrender.com
# Example custom host: api.yourdomain.com
SITE_URL=https://api.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
DEV_SERVER_HOST=api.yourdomain.com
DEV_SERVER_PORT=8000
ALLOWED_HOSTS=api.yourdomain.com,kis-django-live.onrender.com
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com,https://kis-django-live.onrender.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
USE_X_FORWARDED_PROTO=True
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
X_FRAME_OPTIONS=DENY
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=True

# ==========================================
# 02. Database - Supabase PostgreSQL
# ==========================================
# Replace YOUR-PASSWORD in Render secrets, not in git.
# If Supabase gives you a pooler URL, use the pooler URL for Render web workers.

DATABASE_URL=postgresql://postgres:YOUR-SUPABASE-DB-PASSWORD@db.jzmamwdatswzglpkdwoi.supabase.co:5432/postgres

# ==========================================
# 03. Redis / Celery / Cache
# ==========================================
# Recommended for production. Use Render Redis, Upstash Redis, or another managed Redis.

REDIS_URL=redis://USER:PASSWORD@HOST:6379/0
CELERY_BROKER_URL=redis://USER:PASSWORD@HOST:6379/0
CELERY_RESULT_BACKEND=redis://USER:PASSWORD@HOST:6379/1

# ==========================================
# 04. JWT / Auth
# ==========================================

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_ISSUER=https://api.yourdomain.com
JWT_AUDIENCE=messaging-platform

# Optional future RS256 migration. Leave commented unless configured in settings.
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ==========================================
# 05. NestJS / Realtime / Messaging Integration
# ==========================================
# Django uses these to notify the NestJS realtime service.
# NestJS must use the same DJANGO_INTERNAL_TOKEN value for internal auth/signatures.

NEST_INTERNAL_URL=https://chat.yourdomain.com/internal
NEST_INTERNAL_TOKEN=${DJANGO_INTERNAL_TOKEN}

# These are not read by Django directly in all paths, but keeping them here helps
# you mirror the required NestJS Render environment.
NEST_PUBLIC_URL=https://chat.yourdomain.com
NEST_SOCKET_URL=https://chat.yourdomain.com
MONGODB_ATLAS_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/kis_chat?retryWrites=true&w=majority
DJANGO_BASE_URL=https://api.yourdomain.com
DJANGO_AUTH_INTROSPECT_URL=https://api.yourdomain.com/api/v1/chat/auth/introspect/
DJANGO_CONV_PERMS_URL=https://api.yourdomain.com/api/v1/chat/conversations/ws-permissions/
DJANGO_SEQ_URL=https://api.yourdomain.com/api/v1/chat/messages/allocate-seq/
SOCKET_IO_CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# ==========================================
# 06. Flutterwave Payments - USD Direct Provider
# ==========================================
# Use Flutterwave live keys only after sandbox proof and legal/payment review.

FLW_PUBLIC_KEY=replace-with-flutterwave-public-key
FLW_SECRET_KEY=replace-with-flutterwave-secret-key
FLW_WEBHOOK_SECRET=replace-with-flutterwave-webhook-secret-or-verif-hash
FLW_REDIRECT_URL=https://yourdomain.com/payments/complete
KIS_DIRECT_PAYMENT_PROVIDER_LINKS_ENABLED=True
PAYMENTS_MOCK=False
KIS_COMMERCE_DEFAULT_PAYMENT_PROVIDER=flutterwave
KIS_EDUCATION_DEFAULT_PAYMENT_PROVIDER=flutterwave
KIS_HEALTH_DEFAULT_PAYMENT_PROVIDER=flutterwave

# Legal safety: KIS promotional credits must never become cash, transferable value,
# withdrawable balance, exchange-rated currency, or wallet settlement for commerce.
KIS_LEGACY_WALLET_DEPOSIT_ENABLED=False
KIS_LEGACY_WALLET_TRANSFER_ENABLED=False
KIS_LEGACY_CASH_CREDIT_CONVERSION_ENABLED=False
KIS_LEGACY_WALLET_UPGRADE_ENABLED=False
KIS_LEGACY_PROMO_CASH_BONUS_ENABLED=False
KIS_LEGACY_COMMERCE_WALLET_CHECKOUT_ENABLED=False
KIS_LEGACY_EDUCATION_WALLET_CHECKOUT_ENABLED=False
KIS_LEGACY_HEALTH_WALLET_CHECKOUT_ENABLED=False

# Monetization controls. Keep enforcement off until launch approval.
KIS_PROFITABILITY_BILLING_ENABLED=False
KIS_PROFITABILITY_ENTITLEMENTS_ENFORCED=False
KIS_PROFITABILITY_TRIALS_ENABLED=False
KIS_PROFITABILITY_PROMOTION_CHECKOUT_ENABLED=False
KIS_PROFITABILITY_ENTERPRISE_LEADS_ENABLED=False

# ==========================================
# 07. Firebase Push Notifications
# ==========================================
# For Render, prefer FIREBASE_CREDENTIALS_JSON over a local file path.

NOTIFICATIONS_PUSH_PROVIDER=firebase
FIREBASE_APP_NAME=kis-backend
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"replace-me"}
FIREBASE_CREDENTIALS_FILE=
FCM_SERVER_KEY=
FIREBASE_SERVER_KEY=

# ==========================================
# 08. SMS / OTP - Infobip
# ==========================================

INFOBIP_API_KEY=replace-with-infobip-api-key
INFOBIP_BASE=https://your-infobip-base-url
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_DEBUG_LOG_CODES=False

# ==========================================
# 09. Email / SMTP
# ==========================================
# Needed for password reset, receipts, admin alerts, support, and launch operations.

EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="KIS <no-reply@yourdomain.com>"

# ==========================================
# 10. Error Monitoring / Observability
# ==========================================
# Sentry is optional but strongly recommended for live launch.

SENTRY_DSN=replace-with-sentry-dsn
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO

# ==========================================
# 11. Media Uploads / Storage / Safety
# ==========================================
# IMPORTANT: current Django code still uses default_storage/MEDIA_ROOT unless an object-storage
# backend is added/configured. Render local disk is not reliable for production user uploads.
# Use a persistent disk for test only, or add S3/R2/Cloudinary storage before media-heavy launch.

MEDIA_URL=/media/
UPLOAD_MAX_BYTES=52428800
MEDIA_SIGNED_URL_TTL_SECONDS=300
UPLOAD_SCAN_REQUIRED=False
MEDIA_SAFETY_ENABLED=True
MEDIA_EXPLICIT_SCAN_REQUIRED=False
MEDIA_SAFETY_PROVIDER=stub
MEDIA_SAFETY_LIVE_PROVIDER_CALLS_ENABLED=False
MEDIA_SAFETY_MAX_UPLOAD_BYTES=52428800
MEDIA_SAFETY_ALLOWED_MIME_TYPES=
MEDIA_SAFETY_ALLOWED_MIME_PREFIXES=
MEDIA_SAFETY_ALLOWED_EXTENSIONS=
MEDIA_SAFETY_BLOCKED_EXTENSIONS=

# Object storage. For Render free deploys, use Supabase Storage so uploaded files survive restarts.
# Create a Supabase Storage bucket such as kis-media, enable S3/Storage access, and keep service role keys server-only.
OBJECT_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://jzmamwdatswzglpkdwoi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=kis-media
SUPABASE_STORAGE_PUBLIC_BUCKET=True
SUPABASE_STORAGE_API_URL=https://jzmamwdatswzglpkdwoi.supabase.co/storage/v1
SUPABASE_STORAGE_TIMEOUT_SECONDS=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional explicit-content scanning providers. Keep disabled until configured and tested.
EXPLICIT_CONTENT_PROVIDER=
AWS_REKOGNITION_REGION=
GOOGLE_VISION_API_KEY=
HIVE_API_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
CLOUDFLARE_IMAGES_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=

# ==========================================
# 12. Verification / KYC / KYB Providers
# ==========================================
# Enable live calls only after provider approval, webhook proof, and review workflow QA.

VERIFICATION_PROVIDER_PRIMARY=dojah
VERIFICATION_PROVIDER_FALLBACK=sumsub
VERIFICATION_WEBHOOK_SECRET=replace-with-verification-webhook-secret
VERIFICATION_LIVE_PROVIDER_CALLS_ENABLED=False
VERIFICATION_PROVIDER_SANDBOX_ENABLED=True
VERIFICATION_PROVIDER_SANDBOX_NETWORK_ENABLED=False
VERIFICATION_PROVIDER_TIMEOUT_SECONDS=10
VERIFICATION_WEBHOOK_BASE_URL=https://api.yourdomain.com
VERIFICATION_PROVIDER_LIVE_ALLOWED_ENVS=production,staging
VERIFICATION_LIVE_PROVIDER_SUBJECTS=user,shop,partner,health,education
VERIFICATION_EXPIRY_REMINDER_DAYS=30,14,7,1
DOJAH_APP_ID=replace-with-dojah-app-id
DOJAH_SECRET_KEY=replace-with-dojah-secret-key
DOJAH_BASE_URL=https://api.dojah.io
SUMSUB_APP_TOKEN=replace-with-sumsub-app-token
SUMSUB_SECRET_KEY=replace-with-sumsub-secret-key
SUMSUB_BASE_URL=https://api.sumsub.com
SMILE_ID_PARTNER_ID=replace-with-smile-id-partner-id
SMILE_ID_API_KEY=replace-with-smile-id-api-key
SMILE_ID_BASE_URL=https://api.smileidentity.com

# ==========================================
# 13. AI Assistance Providers
# ==========================================
# Keep live calls disabled unless safety, privacy, child-safety, and pastoral review are complete.

KIS_AI_ASSISTANCE_ENABLED=True
KIS_AI_LIVE_PROVIDER_CALLS_ENABLED=False
KIS_AI_PROVIDER=
KIS_AI_OUTPUT_MODERATION_REQUIRED=True
KIS_AI_INPUT_REDACTION_REQUIRED=True
KIS_AI_CHILD_SAFE_MODE_REQUIRED=True
KIS_AI_STORE_PROMPTS_ENABLED=False
KIS_AI_STORE_RESPONSES_ENABLED=False
KIS_AI_MEDICAL_DIAGNOSIS_ENABLED=False
KIS_AI_FINANCIAL_ADVICE_ENABLED=False
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_STREAM_URL=https://api.groq.com/v1/chat/completions
GROQ_DEFAULT_MODEL=groq-1
GROQ_MODEL_TRIAGE=groq-triage
GROQ_MODEL_CLINICAL=groq-clinical
GROQ_MODEL_LAB=groq-lab
GROQ_MODEL_PHARMACY=groq-pharmacy
GROQ_MODEL_COMMAND=groq-command
GEMINI_API_KEY=

# ==========================================
# 14. Public Web / Embeds / Growth
# ==========================================

KIS_PUBLIC_WEB_ENABLED=True
KIS_PUBLIC_WEB_BASE_URL=https://yourdomain.com
KIS_PUBLIC_WEB_INDEXING_ENABLED=False
KIS_PUBLIC_REFERRALS_ENABLED=False
KIS_PUBLIC_EMBED_BASE_URL=https://yourdomain.com
KIS_EMBED_SIGNING_SECRET=replace-with-strong-embed-signing-secret
KIS_EMBEDS_ENABLED=False
KIS_LAUNCH_CUT_MODE=80
KIS_PARITY_95_FEATURES_ENABLED=False
KIS_DIFFERENTIATION_120_FEATURES_ENABLED=False
KIS_EXPERIMENTAL_120_FEATURES_ENABLED=False

# ==========================================
# 15. Live Streaming
# ==========================================
# Keep disabled unless provider integration and moderation are launch-ready.

LIVE_STREAM_PROVIDER=disabled
LIVE_STREAM_PROVIDER_SANDBOX_ENABLED=False
LIVE_STREAM_WEBHOOK_SECRET=replace-with-live-provider-webhook-secret
LIVE_STREAM_DEFAULT_LATENCY=standard
LIVE_STREAM_DEV_BASE_URL=rtmp://localhost/live
LIVE_STREAM_DEV_PLAYBACK_BASE_URL=https://localhost/live

# Future provider placeholders.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ==========================================
# 16. Health / Calendar / Service Controls
# ==========================================

GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://api.yourdomain.com/api/v1/health/google-calendar/callback/

