HEALTH_OPS_MICROS_PER_KISC=100000
HEALTH_OPS_USD_PER_KISC=100
HEALTH_OPS_PROGRESS_CACHE_TTL=3600
SERVICE_ENFORCE_BUFFERS=False
SERVICE_ENFORCE_COVERAGE=False
SERVICE_ENFORCE_TRAVEL_RADIUS=False
SERVICE_ENFORCE_REMOTE_REGIONS=False
SERVICE_ENFORCE_GROUP_CAPACITY=False
SERVICE_ENABLE_QUOTES=False
SERVICE_ENABLE_NEGOTIATION=False
SERVICE_ENABLE_PACKAGE_PRICING=False
SERVICE_ENABLE_ADDONS=False
SERVICE_ENFORCE_MINIMUM_CHARGE=False
SERVICE_HANDLE_TAX_INCLUSIVE=False
COMMERCE_DEFAULT_TAX_RATE_PCT=0
SERVICE_REQUIRE_TERMS_ACCEPTANCE=False
SERVICE_ENFORCE_REQUIREMENTS=False
SERVICE_ENFORCE_REFUND_POLICY=False
SERVICE_ENFORCE_RESCHEDULE_POLICY=False

# ==========================================
# 17. API Throttling / Abuse Controls
# ==========================================

THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_ADMIN_BURST=60/min
THROTTLE_ADMIN_SUSTAINED=1000/day
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_OTP=5/min
THROTTLE_PASSWORD_RESET=5/min
THROTTLE_UPLOAD=30/min
THROTTLE_SEARCH=60/min
THROTTLE_MESSAGING=120/min
THROTTLE_BROADCAST_PROFILE_CREATE=10/min
THROTTLE_BROADCAST_PROFILE_MANAGE=60/min
THROTTLE_BROADCAST_PROFILE_ATTACHMENT=30/min

# ==========================================
# 18. Mobile / Frontend Values To Mirror In React Native Env
# ==========================================
# These are listed here for deployment coordination. Put them in the frontend/mobile env too.

MOBILE_DJANGO_API_BASE_URL=https://api.yourdomain.com/api/v1
MOBILE_CHAT_API_BASE_URL=https://chat.yourdomain.com
MOBILE_SOCKET_URL=https://chat.yourdomain.com
MOBILE_PUBLIC_WEB_BASE_URL=https://yourdomain.com

# ==========================================
# 19. Launch Safety Notes
# ==========================================
# Before enabling live provider calls or live money movement, run the launch verifiers:
# python3 manage.py check --deploy
# python3 manage.py verify_deployment_security
# python3 manage.py verify_payment_launch
# python3 manage.py verify_media_safety_launch
# python3 manage.py verify_broadcast_channels_launch
# python3 manage.py verify_public_web_launch
# python3 manage.py verify_verification_launch
