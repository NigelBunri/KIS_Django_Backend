# ==========================================
# Django Environment Example
# ==========================================
# Copy to .env locally or configure these values in your hosting provider.
# Never commit real secrets, database passwords, private keys, or provider tokens.

DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False

# Generate unique high-entropy values per environment.
SECRET_KEY=replace-with-a-strong-random-django-secret-at-least-50-chars
JWT_SECRET=replace-with-a-different-strong-random-jwt-secret-at-least-50-chars
DJANGO_INTERNAL_TOKEN=replace-with-a-strong-random-internal-service-token
INTERNAL_SIGNATURE_REQUIRED=True
INTERNAL_SIGNATURE_MAX_SKEW_SECONDS=300

# Public deployment URLs/hosts.
SITE_URL=https://api.example.com
API_BASE_URL=https://api.example.com
DEV_SERVER_HOST=api.example.com
DEV_SERVER_PORT=8000
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Only used if django-cors-headers is enabled in this deployment.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
USE_X_FORWARDED_PROTO=True

TIME_ZONE=UTC

# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ==========================================
# JWT
# ==========================================

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=messaging-platform

# ==========================================
# Redis / Celery
# ==========================================

REDIS_URL=redis://HOST:6379/0
CELERY_BROKER_URL=redis://HOST:6379/0
CELERY_RESULT_BACKEND=redis://HOST:6379/1

# ==========================================
# Payments
# ==========================================

FLW_PUBLIC_KEY=replace-with-flutterwave-public-key
FLW_SECRET_KEY=replace-with-flutterwave-secret-key
FLW_WEBHOOK_SECRET=replace-with-flutterwave-webhook-secret
FLW_REDIRECT_URL=https://app.example.com/payments/complete
PAYMENTS_MOCK=False

# ==========================================
# Notifications / Firebase
# ==========================================

NOTIFICATIONS_PUSH_PROVIDER=firebase
FIREBASE_APP_NAME=kis-backend
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CREDENTIALS_FILE=/secure/path/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
FCM_SERVER_KEY=
FIREBASE_SERVER_KEY=

# Upload controls
UPLOAD_MAX_BYTES=52428800
# Private media signed download URLs expire quickly by default.
MEDIA_SIGNED_URL_TTL_SECONDS=300
# Set to True/1 when an antivirus or malware scanning worker is deployed.
UPLOAD_SCAN_REQUIRED=False

# ==========================================
# API throttling
# ==========================================
# Production-safe defaults are also enforced in settings when DEBUG=False.
# Increase carefully per deployment capacity and abuse monitoring.
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_ADMIN_BURST=60/min
THROTTLE_ADMIN_SUSTAINED=1000/day
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_OTP=5/min
THROTTLE_PASSWORD_RESET=5/min
THROTTLE_UPLOAD=30/min
THROTTLE_SEARCH=60/min
THROTTLE_MESSAGING=120/min
THROTTLE_BROADCAST_PROFILE_CREATE=10/min
THROTTLE_BROADCAST_PROFILE_MANAGE=60/min
THROTTLE_BROADCAST_PROFILE_ATTACHMENT=30/min

# ==========================================
# SMS / OTP
# ==========================================

INFOBIP_API_KEY=replace-with-infobip-api-key
INFOBIP_BASE=https://example.api.infobip.com
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
# Keep false outside a private local debug session. Production refuses startup if true.
OTP_DEBUG_LOG_CODES=False

# ==========================================
# AI Providers
# ==========================================

GROQ_API_KEY=replace-with-groq-key
GEMINI_API_KEY=replace-with-gemini-key

# ==========================================
# Health Ops / Service Controls
# ==========================================

HEALTH_OPS_MICROS_PER_KISC=100000
HEALTH_OPS_USD_PER_KISC=100
HEALTH_OPS_PROGRESS_CACHE_TTL=3600
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
SERVICE_ENFORCE_BUFFERS=False
SERVICE_ENFORCE_COVERAGE=False
SERVICE_ENFORCE_TRAVEL_RADIUS=False
SERVICE_ENFORCE_REMOTE_REGIONS=False
SERVICE_ENFORCE_GROUP_CAPACITY=False
SERVICE_ENABLE_QUOTES=False
SERVICE_ENABLE_NEGOTIATION=False
SERVICE_ENABLE_PACKAGE_PRICING=False
SERVICE_ENABLE_ADDONS=False
SERVICE_ENFORCE_MINIMUM_CHARGE=False
SERVICE_HANDLE_TAX_INCLUSIVE=False
COMMERCE_DEFAULT_TAX_RATE_PCT=0
SERVICE_REQUIRE_TERMS_ACCEPTANCE=False
SERVICE_ENFORCE_REQUIREMENTS=False
SERVICE_ENFORCE_REFUND_POLICY=False
SERVICE_ENFORCE_RESCHEDULE_POLICY=False

# ==========================================
# Nest / Realtime Integration
# ==========================================

NEST_INTERNAL_URL=https://chat.example.com/internal
NEST_INTERNAL_TOKEN=${DJANGO_INTERNAL_TOKEN}
