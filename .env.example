# ==========================================
# Django Environment Example
# ==========================================
# Copy to .env locally or configure these values in your hosting provider.
# Never commit real secrets, database passwords, private keys, or provider tokens.

DJANGO_ENV=production
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False

# Generate unique high-entropy values per environment.
SECRET_KEY=replace-with-a-strong-random-django-secret-at-least-50-chars
JWT_SECRET=replace-with-a-different-strong-random-jwt-secret-at-least-50-chars
DJANGO_INTERNAL_TOKEN=replace-with-a-strong-random-internal-service-token
INTERNAL_SIGNATURE_REQUIRED=True
INTERNAL_SIGNATURE_MAX_SKEW_SECONDS=300

# Public deployment URLs/hosts.
SITE_URL=https://api.example.com
API_BASE_URL=https://api.example.com
DEV_SERVER_HOST=api.example.com
DEV_SERVER_PORT=8000
ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
# Only used if django-cors-headers is enabled in this deployment.
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
USE_X_FORWARDED_PROTO=True

TIME_ZONE=UTC

# ==========================================
# Database
# ==========================================

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# ==========================================
# JWT
# ==========================================

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_ISSUER=https://api.example.com
JWT_AUDIENCE=messaging-platform

# RS256 migration (recommended — isolates signing key from NestJS).
# Set SIMPLE_JWT["ALGORITHM"] = "RS256" and provide the private key below.
# NestJS verifies with the public key only, so a NestJS compromise cannot forge tokens.
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ==========================================
# Redis / Celery
# ==========================================

REDIS_URL=redis://HOST:6379/0
CELERY_BROKER_URL=redis://HOST:6379/0
CELERY_RESULT_BACKEND=redis://HOST:6379/1

# ==========================================
# Payments
# ==========================================

FLW_PUBLIC_KEY=replace-with-flutterwave-public-key
FLW_SECRET_KEY=replace-with-flutterwave-secret-key
FLW_WEBHOOK_SECRET=replace-with-flutterwave-webhook-secret
FLW_REDIRECT_URL=https://app.example.com/payments/complete
KIS_DIRECT_PAYMENT_PROVIDER_LINKS_ENABLED=False
PAYMENTS_MOCK=False
# Legacy stored-value features stay disabled by default. Enable only for a
# controlled migration/test after legal approval; never expose these as public
# KIS Coin buy, transfer, withdraw, or cash-conversion flows.
KIS_LEGACY_WALLET_DEPOSIT_ENABLED=False
KIS_LEGACY_WALLET_TRANSFER_ENABLED=False
KIS_LEGACY_CASH_CREDIT_CONVERSION_ENABLED=False
KIS_LEGACY_WALLET_UPGRADE_ENABLED=False
KIS_LEGACY_PROMO_CASH_BONUS_ENABLED=False
KIS_LEGACY_COMMERCE_WALLET_CHECKOUT_ENABLED=False
KIS_COMMERCE_DEFAULT_PAYMENT_PROVIDER=flutterwave
KIS_LEGACY_EDUCATION_WALLET_CHECKOUT_ENABLED=False
KIS_EDUCATION_DEFAULT_PAYMENT_PROVIDER=flutterwave
KIS_LEGACY_HEALTH_WALLET_CHECKOUT_ENABLED=False
KIS_HEALTH_DEFAULT_PAYMENT_PROVIDER=flutterwave

# ==========================================
# Notifications / Firebase
# ==========================================

NOTIFICATIONS_PUSH_PROVIDER=firebase
FIREBASE_APP_NAME=kis-backend
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_CREDENTIALS_FILE=/secure/path/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
FCM_SERVER_KEY=
FIREBASE_SERVER_KEY=

# Upload controls
UPLOAD_MAX_BYTES=52428800
# Private media signed download URLs expire quickly by default.
MEDIA_SIGNED_URL_TTL_SECONDS=300
# Set to True/1 when an antivirus or malware scanning worker is deployed.
UPLOAD_SCAN_REQUIRED=False
# Central Christian/family media safety gate. Keep provider live calls disabled
# until staging credentials and callback/audit handling are approved.
MEDIA_SAFETY_ENABLED=True
MEDIA_EXPLICIT_SCAN_REQUIRED=False
MEDIA_SAFETY_PROVIDER=stub
MEDIA_SAFETY_LIVE_PROVIDER_CALLS_ENABLED=False
MEDIA_SAFETY_MAX_UPLOAD_BYTES=52428800
MEDIA_SAFETY_ALLOWED_MIME_TYPES=
MEDIA_SAFETY_ALLOWED_MIME_PREFIXES=
MEDIA_SAFETY_ALLOWED_EXTENSIONS=
MEDIA_SAFETY_BLOCKED_EXTENSIONS=

# ==========================================
# API throttling
# ==========================================
# Production-safe defaults are also enforced in settings when DEBUG=False.
# Increase carefully per deployment capacity and abuse monitoring.
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
THROTTLE_ADMIN_BURST=60/min
THROTTLE_ADMIN_SUSTAINED=1000/day
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=5/min
THROTTLE_OTP=5/min
THROTTLE_PASSWORD_RESET=5/min
THROTTLE_UPLOAD=30/min
THROTTLE_SEARCH=60/min
THROTTLE_MESSAGING=120/min
THROTTLE_BROADCAST_PROFILE_CREATE=10/min
THROTTLE_BROADCAST_PROFILE_MANAGE=60/min
THROTTLE_BROADCAST_PROFILE_ATTACHMENT=30/min

# ==========================================
# SMS / OTP
# ==========================================

INFOBIP_API_KEY=replace-with-infobip-api-key
INFOBIP_BASE=https://example.api.infobip.com
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
# Keep false outside a private local debug session. Production refuses startup if true.
OTP_DEBUG_LOG_CODES=False

# ==========================================
# AI Providers
# ==========================================

KIS_AI_ASSISTANCE_ENABLED=True
KIS_AI_LIVE_PROVIDER_CALLS_ENABLED=False
KIS_AI_PROVIDER=
KIS_AI_OUTPUT_MODERATION_REQUIRED=True
KIS_AI_INPUT_REDACTION_REQUIRED=True
KIS_AI_CHILD_SAFE_MODE_REQUIRED=True
KIS_AI_STORE_PROMPTS_ENABLED=False
KIS_AI_STORE_RESPONSES_ENABLED=False
KIS_AI_MEDICAL_DIAGNOSIS_ENABLED=False
KIS_AI_FINANCIAL_ADVICE_ENABLED=False
GROQ_API_KEY=replace-with-groq-key
GEMINI_API_KEY=replace-with-gemini-key

# ==========================================
# Public Web / Growth
# ==========================================

KIS_PUBLIC_WEB_ENABLED=True
KIS_PUBLIC_WEB_BASE_URL=https://kis.app
KIS_PUBLIC_WEB_INDEXING_ENABLED=False
KIS_PUBLIC_REFERRALS_ENABLED=False
KIS_EMBEDS_ENABLED=False
KIS_PUBLIC_EMBED_BASE_URL=https://kis.app
KIS_EMBED_SIGNING_SECRET=replace-with-strong-embed-signing-secret
KIS_LAUNCH_CUT_MODE=80
KIS_PARITY_95_FEATURES_ENABLED=False
KIS_DIFFERENTIATION_120_FEATURES_ENABLED=False
KIS_EXPERIMENTAL_120_FEATURES_ENABLED=False

# ==========================================
# Health Ops / Service Controls
# ==========================================

# Legacy internal micro-unit conversion knobs are kept only so old health
# records can be displayed/migrated safely. Do not expose these as a public
# KISC-to-USD exchange rate or as a user-facing payment product.
HEALTH_OPS_MICROS_PER_KISC=100000
HEALTH_OPS_USD_PER_KISC=100
HEALTH_OPS_PROGRESS_CACHE_TTL=3600
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
SERVICE_ENFORCE_BUFFERS=False
SERVICE_ENFORCE_COVERAGE=False
SERVICE_ENFORCE_TRAVEL_RADIUS=False
SERVICE_ENFORCE_REMOTE_REGIONS=False
SERVICE_ENFORCE_GROUP_CAPACITY=False
SERVICE_ENABLE_QUOTES=False
SERVICE_ENABLE_NEGOTIATION=False
SERVICE_ENABLE_PACKAGE_PRICING=False
SERVICE_ENABLE_ADDONS=False
SERVICE_ENFORCE_MINIMUM_CHARGE=False
SERVICE_HANDLE_TAX_INCLUSIVE=False
COMMERCE_DEFAULT_TAX_RATE_PCT=0
SERVICE_REQUIRE_TERMS_ACCEPTANCE=False
SERVICE_ENFORCE_REQUIREMENTS=False
SERVICE_ENFORCE_REFUND_POLICY=False
SERVICE_ENFORCE_RESCHEDULE_POLICY=False

# ==========================================
# Nest / Realtime Integration
# ==========================================

NEST_INTERNAL_URL=https://chat.example.com/internal
NEST_INTERNAL_TOKEN=${DJANGO_INTERNAL_TOKEN}

# ==========================================
# Verification / KYC / KYB Providers
# ==========================================
# Primary recommendation for Nigeria/Africa-first launch: Dojah.
# Fallback/global KYB/KYC provider: Sumsub. Smile ID can be enabled later for Africa-specific identity coverage.
VERIFICATION_PROVIDER_PRIMARY=dojah
VERIFICATION_PROVIDER_FALLBACK=sumsub
VERIFICATION_WEBHOOK_SECRET=replace-with-verification-webhook-secret
VERIFICATION_LIVE_PROVIDER_CALLS_ENABLED=false
VERIFICATION_PROVIDER_SANDBOX_ENABLED=true
VERIFICATION_PROVIDER_SANDBOX_NETWORK_ENABLED=false
VERIFICATION_PROVIDER_TIMEOUT_SECONDS=10
VERIFICATION_WEBHOOK_BASE_URL=https://api.example.com
VERIFICATION_PROVIDER_LIVE_ALLOWED_ENVS=staging
VERIFICATION_LIVE_PROVIDER_SUBJECTS=
VERIFICATION_EXPIRY_REMINDER_DAYS=30,14,7,1
DOJAH_APP_ID=replace-with-dojah-app-id
DOJAH_SECRET_KEY=replace-with-dojah-secret-key
DOJAH_BASE_URL=https://api.dojah.io
SUMSUB_APP_TOKEN=replace-with-sumsub-app-token
SUMSUB_SECRET_KEY=replace-with-sumsub-secret-key
SUMSUB_BASE_URL=https://api.sumsub.com
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_BASE_URL=

# ==========================================
# Feed Channels / Live Streaming
# ==========================================
# Disabled by default. Phase 07 stores provider-neutral live stream state only.
LIVE_STREAM_PROVIDER=disabled
LIVE_STREAM_PROVIDER_SANDBOX_ENABLED=False
LIVE_STREAM_WEBHOOK_SECRET=replace-with-live-provider-webhook-secret
LIVE_STREAM_DEFAULT_LATENCY=standard
LIVE_STREAM_DEV_BASE_URL=rtmp://localhost/live
LIVE_STREAM_DEV_PLAYBACK_BASE_URL=https://localhost/live

# ==========================================
# Feed Channels / Public Embeds
# ==========================================
# Keep disabled until embed QA, legal review, CSP, and domain policy are complete.
KIS_PUBLIC_EMBED_BASE_URL=https://app.example.com
KIS_EMBED_SIGNING_SECRET=replace-with-strong-secret
KIS_EMBEDS_ENABLED=False
