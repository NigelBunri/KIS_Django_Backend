# Basic env example
DJANGO_ENV=local
SECRET_KEY=change-me-for-dev
DEBUG=True
ALLOWED_HOSTS=10.14.20.99,10.14.20.99
TIME_ZONE=UTC
DATABASE_URL=sqlite:///db.sqlite3

# JWT override
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Redis / Celery (for production)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Payments (Flutterwave)
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLW_REDIRECT_URL=https://kis.app/payments/complete
PAYMENTS_MOCK=True
# AI providers (Bible bot/meditations)
GROQ_API_KEY=
GEMINI_API_KEY=

# Health Ops (DHOS foundation)
HEALTH_OPS_MICROS_PER_KISC=100000
HEALTH_OPS_USD_PER_KISC=100
HEALTH_OPS_PROGRESS_CACHE_TTL=3600
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
SERVICE_ENFORCE_BUFFERS=False
SERVICE_ENFORCE_COVERAGE=False
SERVICE_ENFORCE_TRAVEL_RADIUS=False
SERVICE_ENFORCE_REMOTE_REGIONS=False
SERVICE_ENFORCE_GROUP_CAPACITY=False
SERVICE_ENABLE_QUOTES=False
SERVICE_ENABLE_NEGOTIATION=False
SERVICE_ENABLE_PACKAGE_PRICING=False
SERVICE_ENABLE_ADDONS=False
SERVICE_ENFORCE_MINIMUM_CHARGE=False
SERVICE_HANDLE_TAX_INCLUSIVE=False
COMMERCE_DEFAULT_TAX_RATE_PCT=0
SERVICE_REQUIRE_TERMS_ACCEPTANCE=False
SERVICE_ENFORCE_REQUIREMENTS=False
SERVICE_ENFORCE_REFUND_POLICY=False
SERVICE_ENFORCE_RESCHEDULE_POLICY=False
